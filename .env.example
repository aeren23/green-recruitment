DATABASE_URL=sqlite:///data/app.db
HASH_SECRET=change-me
EMPLOYER_TOKEN=change-me
EMBED_MODEL=intfloat/multilingual-e5-small
EMBED_DEVICE=cuda
# true: load the embedding model from the local cache only (no network at start-up).
# Download it once first; see the error message if it is missing.
EMBED_LOCAL_FILES_ONLY=true
OLLAMA_URL=http://localhost:11434
LLM_MODEL=qwen2.5:3b
TOP_K=5
MAX_CV_CHARS=6000
MAX_UPLOAD_BYTES=1048576
QUALITY_K=10
DRAFT_TTL_HOURS=24
DECISION_RETENTION_DAYS=30
SHORTLIST_RETENTION_DAYS=30
SECTION_ALPHA=experience:1.0,project:1.0,certification:0.8,education:0.8,summary:0.7,skills:0.6
COUNTRY_ISO=TUR
GREEN_TRACKING=true
BENCH_CV_REFERENCE_DATE=2018-01-01
